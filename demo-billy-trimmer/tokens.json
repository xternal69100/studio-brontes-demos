{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Démonstration fictive d’un outil de précision intime, laboratoire de salle de bain après minuit.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.02,
          0.031,
          0.086
        ],
        "hex": "#050816"
      }
    },
    "cobalt": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.098,
          0.235,
          1
        ],
        "hex": "#193cff"
      }
    },
    "cobalt-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.027,
          0.078,
          0.396
        ],
        "hex": "#071465"
      }
    },
    "acid": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.839,
          1,
          0
        ],
        "hex": "#d6ff00"
      }
    },
    "ice": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.914,
          0.945,
          1
        ],
        "hex": "#e9f1ff"
      }
    },
    "steel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.686,
          0.773,
          0.91
        ],
        "hex": "#afc5e8"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.306,
          0.396,
          0.576
        ],
        "hex": "#4e6593"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.11,
          0.286
        ],
        "hex": "#0a1c49"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "hairline": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    },
    "media": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontSize": {
          "value": 9,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.055,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    }
  }
}
